  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @default(now()) @updatedAt
  from_Payment_trustAccount Payment[]                   @relation("Payment_trustAccount")

  @@index([firmId])
  @@index([officeId])
}

model TrustLedgerAccount {
  id                                        String                       @id @default(cuid())
  firm                                      Firm                         @relation("TrustLedgerAccount_firm", fields: [firmId], references: [id])
  firmId                                    String                       @map("firm")
  matter                                    Matter?                      @relation("TrustLedgerAccount_matter", fields: [matterId], references: [id])
  matterId                                  String?                      @map("matter")
  trustAccount                              TrustAccount                 @relation("TrustLedgerAccount_trustAccount", fields: [trustAccountId], references: [id])
  trustAccountId                            String                       @map("trustAccount")
  client                                    Contact                      @relation("TrustLedgerAccount_client", fields: [clientId], references: [id])
  clientId                                  String                       @map("client")
  ledgerNumber                              String                       @default("")
  status                                    TrustLedgerAccountStatusType @default(active)
  currencyCode                              String                       @default("USD")
  openedAt                                  DateTime?                    @default(now())
