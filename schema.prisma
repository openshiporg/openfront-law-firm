model Payment {
  id                              String                 @id @default(cuid())
  firm                            Firm                   @relation("Payment_firm", fields: [firmId], references: [id])
  firmId                          String                 @map("firm")
  matter                          Matter?                @relation("Payment_matter", fields: [matterId], references: [id])
  matterId                        String?                @map("matter")
  invoice                         Invoice?               @relation("Payment_invoice", fields: [invoiceId], references: [id])
  invoiceId                       String?                @map("invoice")
  trustAccount                    TrustAccount?          @relation("Payment_trustAccount", fields: [trustAccountId], references: [id])
  trustAccountId                  String?                @map("trustAccount")
  payer                           Contact                @relation("Payment_payer", fields: [payerId], references: [id])
  payerId                         String                 @map("payer")
  paymentNumber                   String                 @default("")
  idempotencyKey                  String                 @default("")
