  actions                               AgentAction[]               @relation("AgentAction_agentPrincipal")
  actionEvents                          AgentActionEvent[]          @relation("AgentActionEvent_actorAgent")
  createdAt                             DateTime                    @default(now())
  updatedAt                             DateTime                    @default(now()) @updatedAt
  from_MatterStatusEvent_actorAgent     MatterStatusEvent[]         @relation("MatterStatusEvent_actorAgent")
  from_CommunicationMessage_senderAgent CommunicationMessage[]      @relation("CommunicationMessage_senderAgent")
  from_TrustTransaction_postedByAgent   TrustTransaction[]          @relation("TrustTransaction_postedByAgent")
  from_RetentionAction_performedByAgent RetentionAction[]           @relation("RetentionAction_performedByAgent")
  from_AuditEvent_actorAgent            AuditEvent[]                @relation("AuditEvent_actorAgent")

  @@index([firmId])
  @@index([ownerId])
}

model AgentCredential {
  id               String                    @id @default(cuid())
  firm             Firm                      @relation("AgentCredential_firm", fields: [firmId], references: [id])
  firmId           String                    @map("firm")
  agentPrincipal   AgentPrincipal            @relation("AgentCredential_agentPrincipal", fields: [agentPrincipalId], references: [id])
  agentPrincipalId String                    @map("agentPrincipal")
  name             String                    @default("")
  prefix           String                    @unique @default("")
  secretHash       String                    @default("")
  status           AgentCredentialStatusType @default(active)
  scopes           Json                      @default("[]")
  createdBy        User                      @relation("AgentCredential_createdBy", fields: [createdById], references: [id])
  createdById      String                    @map("createdBy")
  expiresAt        DateTime?
  lastUsedAt       DateTime?
  revokedAt        DateTime?
  revokedBy        User?                     @relation("AgentCredential_revokedBy", fields: [revokedById], references: [id])
  revokedById      String?                   @map("revokedBy")
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @default(now()) @updatedAt

  @@index([firmId])
  @@index([agentPrincipalId])
  @@index([createdById])
  @@index([revokedById])
}

model AgentGrant {
  id               String               @id @default(cuid())
  firm             Firm                 @relation("AgentGrant_firm", fields: [firmId], references: [id])
  firmId           String               @map("firm")
  matter           Matter?              @relation("AgentGrant_matter", fields: [matterId], references: [id])
  matterId         String?              @map("matter")
  agentPrincipal   AgentPrincipal       @relation("AgentGrant_agentPrincipal", fields: [agentPrincipalId], references: [id])
  agentPrincipalId String               @map("agentPrincipal")
  status           AgentGrantStatusType @default(proposed)
  capabilities     Json                 @default("[]")
  reason           String               @default("")
  requestedBy      User                 @relation("AgentGrant_requestedBy", fields: [requestedById], references: [id])
  requestedById    String               @map("requestedBy")
  approvedBy       User?                @relation("AgentGrant_approvedBy", fields: [approvedById], references: [id])
  approvedById     String?              @map("approvedBy")
  approvedAt       DateTime?
  startsAt         DateTime?
  expiresAt        DateTime?
  suspendedAt      DateTime?
  revokedAt        DateTime?
  actions          AgentAction[]        @relation("AgentAction_grant")
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @default(now()) @updatedAt

  @@index([firmId])
  @@index([matterId])
  @@index([agentPrincipalId])
  @@index([requestedById])
  @@index([approvedById])
}

model AgentAction {
  id                          String                   @id @default(cuid())
  firm                        Firm                     @relation("AgentAction_firm", fields: [firmId], references: [id])
  firmId                      String                   @map("firm")
  matter                      Matter?                  @relation("AgentAction_matter", fields: [matterId], references: [id])
  matterId                    String?                  @map("matter")
  agentPrincipal              AgentPrincipal           @relation("AgentAction_agentPrincipal", fields: [agentPrincipalId], references: [id])
  agentPrincipalId            String                   @map("agentPrincipal")
  grant                       AgentGrant               @relation("AgentAction_grant", fields: [grantId], references: [id])
  grantId                     String                   @map("grant")
  actionNumber                String                   @default("")
  idempotencyKey              String                   @unique @default("")
  actionType                  String
  status                      AgentActionStatusType    @default(requested)
  riskLevel                   AgentActionRiskLevelType @default(high)
  requestDigest               String                   @default("")
  requestEnvelope             Json?
  requiresApproval            Boolean                  @default(true)
  requestedByUser             User?                    @relation("AgentAction_requestedByUser", fields: [requestedByUserId], references: [id])
  requestedByUserId           String?                  @map("requestedByUser")
  approvedBy                  User?                    @relation("AgentAction_approvedBy", fields: [approvedById], references: [id])
  approvedById                String?                  @map("approvedBy")
  approvalDigest              String                   @default("")
  approvalExpiresAt           DateTime?
  reviewedAt                  DateTime?
  rejectionReason             String                   @default("")
  contact                     Contact?                 @relation("AgentAction_contact", fields: [contactId], references: [id])
  contactId                   String?                  @map("contact")
  intake                      Intake?                  @relation("AgentAction_intake", fields: [intakeId], references: [id])
  intakeId                    String?                  @map("intake")
  document                    Document?                @relation("AgentAction_document", fields: [documentId], references: [id])
  documentId                  String?                  @map("document")
  invoice                     Invoice?                 @relation("AgentAction_invoice", fields: [invoiceId], references: [id])
  invoiceId                   String?                  @map("invoice")
  payment                     Payment?                 @relation("AgentAction_payment", fields: [paymentId], references: [id])
  paymentId                   String?                  @map("payment")
  trustTransaction            TrustTransaction?        @relation("AgentAction_trustTransaction", fields: [trustTransactionId], references: [id])
  trustTransactionId          String?                  @map("trustTransaction")
  deadline                    Deadline?                @relation("AgentAction_deadline", fields: [deadlineId], references: [id])
  deadlineId                  String?                  @map("deadline")
  task                        LegalTask?               @relation("AgentAction_task", fields: [taskId], references: [id])
  taskId                      String?                  @map("task")
  startedAt                   DateTime?
  completedAt                 DateTime?
  resultDigest                String                   @default("")
  resultEnvelope              Json?
  errorMessage                String                   @default("")
  events                      AgentActionEvent[]       @relation("AgentActionEvent_action")
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @default(now()) @updatedAt
  from_AuditEvent_agentAction AuditEvent[]             @relation("AuditEvent_agentAction")

  @@unique([firmId, actionNumber])
  @@index([firmId])
  @@index([matterId])
  @@index([agentPrincipalId])
  @@index([grantId])
  @@index([actionNumber])
  @@index([requestedByUserId])
  @@index([approvedById])
  @@index([contactId])
  @@index([intakeId])
  @@index([documentId])
  @@index([invoiceId])
  @@index([paymentId])
  @@index([trustTransactionId])
  @@index([deadlineId])
  @@index([taskId])
}

model AgentActionEvent {
  id           String          @id @default(cuid())
  firm         Firm            @relation("AgentActionEvent_firm", fields: [firmId], references: [id])
  firmId       String          @map("firm")
  matter       Matter?         @relation("AgentActionEvent_matter", fields: [matterId], references: [id])
  matterId     String?         @map("matter")
  action       AgentAction     @relation("AgentActionEvent_action", fields: [actionId], references: [id])
  actionId     String          @map("action")
  eventType    String          @default("")
  fromStatus   String          @default("")
  toStatus     String          @default("")
  actorUser    User?           @relation("AgentActionEvent_actorUser", fields: [actorUserId], references: [id])
  actorUserId  String?         @map("actorUser")
  actorAgent   AgentPrincipal? @relation("AgentActionEvent_actorAgent", fields: [actorAgentId], references: [id])
  actorAgentId String?         @map("actorAgent")
  reason       String          @default("")
  occurredAt   DateTime        @default(now())
  metadata     Json?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @default(now()) @updatedAt

  @@index([firmId])
  @@index([matterId])
  @@index([actionId])
  @@index([actorUserId])
  @@index([actorAgentId])
}

model PublicSitePolicy {
  id                        String                     @id @default(cuid())
  firm                      Firm                       @relation("PublicSitePolicy_firm", fields: [firmId], references: [id])
  firmId                    String                     @map("firm")
  status                    PublicSitePolicyStatusType @default(draft)
  publicAccountsEnabled     Boolean                    @default(false)
  publicBookingEnabled      Boolean                    @default(false)
  privacyNotice             String                     @default("")
  privacyNoticeVersion      Int?                       @default(0)
  firstContactNotice        String                     @default("")
  firstContactNoticeVersion Int?                       @default(0)
  aboutStatement            String                     @default("")
  publishedAt               DateTime?
  publishedByUserId         String                     @default("")
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @default(now()) @updatedAt

  @@unique([firmId])
  @@index([firmId])
}

model AttorneyProfile {
  id            String         @id @default(cuid())
  firm          Firm           @relation("AttorneyProfile_firm", fields: [firmId], references: [id])
  firmId        String         @map("firm")
  name          String         @default("")
  slug          String         @default("")
  title         String         @default("")
  focus         String         @default("")
  biography     String         @default("")
  admissions    String         @default("")
  email         String         @default("")
  practiceAreas PracticeArea[] @relation("AttorneyProfile_practiceAreas")
  isPublic      Boolean        @default(false)
  sortOrder     Int?           @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt

  @@unique([firmId, slug])
  @@index([firmId])
  @@index([slug])
}

