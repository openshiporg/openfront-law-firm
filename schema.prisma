  @@unique([firmId, agreementNumber])
  @@index([firmId])
  @@index([matterId])
  @@index([clientId])
  @@index([rateCardId])
  @@index([agreementNumber])
  @@index([signedDocumentVersionId])
  @@index([trustLedgerAccountId])
}

model Invoice {
  id                              String               @id @default(cuid())
  firm                            Firm                 @relation("Invoice_firm", fields: [firmId], references: [id])
  firmId                          String               @map("firm")
  matter                          Matter               @relation("Invoice_matter", fields: [matterId], references: [id])
  matterId                        String               @map("matter")
  client                          Contact              @relation("Invoice_client", fields: [clientId], references: [id])
  clientId                        String               @map("client")
  retainer                        RetainerAgreement?   @relation("Invoice_retainer", fields: [retainerId], references: [id])
  retainerId                      String?              @map("retainer")
  invoiceNumber                   String               @default("")
  status                          InvoiceStatusType    @default(draft)
  currencyCode                    String               @default("USD")
  subtotalMinor                   Int                  @default(0)
  discountMinor                   Int                  @default(0)
  taxMinor                        Int                  @default(0)
  totalMinor                      Int                  @default(0)
  paidMinor                       Int                  @default(0)
  balanceDueMinor                 Int                  @default(0)
  issuedAt                        DateTime?
  dueAt                           DateTime?
  paidAt                          DateTime?
  voidedAt                        DateTime?
  voidReason                      String               @default("")
  memo                            String               @default("")
  lines                           InvoiceLine[]        @relation("InvoiceLine_invoice")
  payments                        Payment[]            @relation("Payment_invoice")
  paymentAllocations              PaymentAllocation[]  @relation("PaymentAllocation_invoice")
  refunds                         Refund[]             @relation("Refund_invoice")
  createdAt                       DateTime             @default(now())
  updatedAt                       DateTime             @default(now()) @updatedAt
  from_PortalShare_invoice        PortalShare[]        @relation("PortalShare_invoice")
  from_ExternalRecordLink_invoice ExternalRecordLink[] @relation("ExternalRecordLink_invoice")
  from_RetentionAction_invoice    RetentionAction[]    @relation("RetentionAction_invoice")
  from_AuditEvent_invoice         AuditEvent[]         @relation("AuditEvent_invoice")
  from_AgentAction_invoice        AgentAction[]        @relation("AgentAction_invoice")

  @@unique([firmId, invoiceNumber])
  @@index([firmId])
  @@index([matterId])
  @@index([clientId])
  @@index([retainerId])
  @@index([invoiceNumber])
}

model InvoiceLine {
  id              String                  @id @default(cuid())
  firm            Firm                    @relation("InvoiceLine_firm", fields: [firmId], references: [id])
  firmId          String                  @map("firm")
  matter          Matter                  @relation("InvoiceLine_matter", fields: [matterId], references: [id])
  matterId        String                  @map("matter")
  invoice         Invoice                 @relation("InvoiceLine_invoice", fields: [invoiceId], references: [id])
  invoiceId       String                  @map("invoice")
