  firm            Firm             @relation("SignatureEvent_firm", fields: [firmId], references: [id])
  firmId          String           @map("firm")
  matter          Matter?          @relation("SignatureEvent_matter", fields: [matterId], references: [id])
  matterId        String?          @map("matter")
  request         SignatureRequest @relation("SignatureEvent_request", fields: [requestId], references: [id])
  requestId       String           @map("request")
  signer          DocumentSigner?  @relation("SignatureEvent_signer", fields: [signerId], references: [id])
  signerId        String?          @map("signer")
  eventType       String           @default("")
  providerEventId String           @default("")
  actorReference  String           @default("")
  occurredAt      DateTime         @default(now())
  evidence        Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now()) @updatedAt

  @@unique([firmId, providerEventId])
  @@index([firmId])
  @@index([matterId])
  @@index([requestId])
  @@index([signerId])
  @@index([providerEventId])
}

model RateCard {
  id                              String              @id @default(cuid())
  firm                            Firm                @relation("RateCard_firm", fields: [firmId], references: [id])
  firmId                          String              @map("firm")
  matter                          Matter?             @relation("RateCard_matter", fields: [matterId], references: [id])
  matterId                        String?             @map("matter")
  name                            String              @default("")
  status                          RateCardStatusType  @default(draft)
  currencyCode                    String              @default("USD")
  effectiveFrom                   DateTime?
  effectiveTo                     DateTime?
  description                     String              @default("")
  rules                           RateRule[]          @relation("RateRule_rateCard")
  createdAt                       DateTime            @default(now())
  updatedAt                       DateTime            @default(now()) @updatedAt
  from_RetainerAgreement_rateCard RetainerAgreement[] @relation("RetainerAgreement_rateCard")

  @@index([firmId])
  @@index([matterId])
}

model RateRule {
  id             String               @id @default(cuid())
  firm           Firm                 @relation("RateRule_firm", fields: [firmId], references: [id])
  firmId         String               @map("firm")
  matter         Matter?              @relation("RateRule_matter", fields: [matterId], references: [id])
  matterId       String?              @map("matter")
  rateCard       RateCard             @relation("RateRule_rateCard", fields: [rateCardId], references: [id])
  rateCardId     String               @map("rateCard")
  user           User?                @relation("RateRule_user", fields: [userId], references: [id])
  userId         String?              @map("user")
  practiceArea   PracticeArea?        @relation("RateRule_practiceArea", fields: [practiceAreaId], references: [id])
  practiceAreaId String?              @map("practiceArea")
  rateType       RateRuleRateTypeType
  amountMinor    Int
  currencyCode   String               @default("USD")
  unitLabel      String               @default("hour")
  priority       Int?                 @default(100)
  effectiveFrom  DateTime?
  effectiveTo    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @default(now()) @updatedAt

  @@index([firmId])
  @@index([matterId])
  @@index([rateCardId])
  @@index([userId])
  @@index([practiceAreaId])
}

model TimeEntry {
  id              String              @id @default(cuid())
  firm            Firm                @relation("TimeEntry_firm", fields: [firmId], references: [id])
  firmId          String              @map("firm")
  matter          Matter              @relation("TimeEntry_matter", fields: [matterId], references: [id])
  matterId        String              @map("matter")
  user            User                @relation("TimeEntry_user", fields: [userId], references: [id])
