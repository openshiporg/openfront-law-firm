  timeEntryId     String?                 @unique @map("timeEntry")
  expense         Expense?                @relation("Expense_invoiceLine")
  lineType        InvoiceLineLineTypeType
  description     String                  @default("")
  quantity        Int?                    @default(1)
  unitAmountMinor Int
  subtotalMinor   Int
  discountMinor   Int?                    @default(0)
  taxMinor        Int?                    @default(0)
  lineTotalMinor  Int
  currencyCode    String                  @default("USD")
  sourceRecordId  String                  @default("")
  serviceDate     DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @default(now()) @updatedAt

  @@index([firmId])
  @@index([matterId])
  @@index([invoiceId])
}

model TrustAccount {
  id                        String                      @id @default(cuid())
  firm                      Firm                        @relation("TrustAccount_firm", fields: [firmId], references: [id])
  firmId                    String                      @map("firm")
  office                    Office?                     @relation("TrustAccount_office", fields: [officeId], references: [id])
  officeId                  String?                     @map("office")
  name                      String                      @default("")
  accountType               TrustAccountAccountTypeType @default(trust)
  status                    TrustAccountStatusType      @default(pending)
  currencyCode              String                      @default("USD")
  financialInstitutionName  String                      @default("")
  bankAccountLastFour       String                      @default("")
  externalAccountReference  String                      @default("")
