  createdAt                       DateTime               @default(now())
  updatedAt                       DateTime               @default(now()) @updatedAt
  from_ExternalRecordLink_payment ExternalRecordLink[]   @relation("ExternalRecordLink_payment")
  from_AuditEvent_payment         AuditEvent[]           @relation("AuditEvent_payment")
  from_AgentAction_payment        AgentAction[]          @relation("AgentAction_payment")

  @@unique([firmId, paymentNumber])
  @@unique([firmId, idempotencyKey])
  @@index([firmId])
  @@index([matterId])
  @@index([invoiceId])
  @@index([trustAccountId])
  @@index([payerId])
  @@index([paymentNumber])
  @@index([idempotencyKey])
  @@index([integrationConnectionId])
  @@index([providerPaymentId])
  @@index([receivedById])
}

