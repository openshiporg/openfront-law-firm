model TrustTransaction {
  id                                      String                              @id @default(cuid())
  firm                                    Firm                                @relation("TrustTransaction_firm", fields: [firmId], references: [id])
  firmId                                  String                              @map("firm")
  transactionNumber                       String                              @default("")
  idempotencyKey                          String                              @unique @default("")
  postingDigest                           String                              @default("")
  trustAccount                            TrustAccount                        @relation("TrustTransaction_trustAccount", fields: [trustAccountId], references: [id])
  trustAccountId                          String                              @map("trustAccount")
  transactionType                         TrustTransactionTransactionTypeType
  status                                  TrustTransactionStatusType          @default(posted)
  currencyCode                            String                              @default("")
  description                             String                              @default("")
  occurredAt                              DateTime
  postedAt                                DateTime                            @default(now())
  postedBy                                User?                               @relation("TrustTransaction_postedBy", fields: [postedById], references: [id])
  postedById                              String?                             @map("postedBy")
  postedByAgent                           AgentPrincipal?                     @relation("TrustTransaction_postedByAgent", fields: [postedByAgentId], references: [id])
  postedByAgentId                         String?                             @map("postedByAgent")
  sourcePayment                           Payment?                            @relation("TrustTransaction_sourcePayment", fields: [sourcePaymentId], references: [id])
  sourcePaymentId                         String?                             @map("sourcePayment")
  sourceRefund                            Refund?                             @relation("TrustTransaction_sourceRefund", fields: [sourceRefundId], references: [id])
  sourceRefundId                          String?                             @map("sourceRefund")
  reversesTransaction                     TrustTransaction?                   @relation("TrustTransaction_reversesTransaction", fields: [reversesTransactionId], references: [id])
  reversesTransactionId                   String?                             @map("reversesTransaction")
  reversalTransactions                    TrustTransaction[]                  @relation("TrustTransaction_reversesTransaction")
  entries                                 TrustLedgerEntry[]                  @relation("TrustLedgerEntry_transaction")
  createdAt                               DateTime                            @default(now())
  updatedAt                               DateTime                            @default(now()) @updatedAt
  from_PaymentAllocation_trustTransaction PaymentAllocation[]                 @relation("PaymentAllocation_trustTransaction")
  from_AuditEvent_trustTransaction        AuditEvent[]                        @relation("AuditEvent_trustTransaction")
  from_AgentAction_trustTransaction       AgentAction[]                       @relation("AgentAction_trustTransaction")

  @@unique([firmId, transactionNumber])
  @@unique([reversesTransactionId])
  @@unique([sourcePaymentId])
  @@unique([sourceRefundId])
  @@index([firmId])
  @@index([transactionNumber])
  @@index([postingDigest])
  @@index([trustAccountId])
  @@index([postedById])
  @@index([postedByAgentId])
  @@index([sourcePaymentId])
  @@index([sourceRefundId])
  @@index([reversesTransactionId])
}

