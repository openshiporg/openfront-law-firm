  @@index([firmId])
  @@index([matterId])
  @@index([incurredById])
  @@index([vendorId])
  @@index([receiptVersionId])
  @@index([approvedById])
}

model RetainerAgreement {
  id                       String                            @id @default(cuid())
  firm                     Firm                              @relation("RetainerAgreement_firm", fields: [firmId], references: [id])
  firmId                   String                            @map("firm")
  matter                   Matter                            @relation("RetainerAgreement_matter", fields: [matterId], references: [id])
  matterId                 String                            @map("matter")
  client                   Contact                           @relation("RetainerAgreement_client", fields: [clientId], references: [id])
  clientId                 String                            @map("client")
  rateCard                 RateCard?                         @relation("RetainerAgreement_rateCard", fields: [rateCardId], references: [id])
  rateCardId               String?                           @map("rateCard")
  agreementNumber          String                            @default("")
  status                   RetainerAgreementStatusType       @default(draft)
  feeStructure             RetainerAgreementFeeStructureType
  currencyCode             String                            @default("USD")
  initialRetainerMinor     Int?
  evergreenThresholdMinor  Int?
  replenishmentAmountMinor Int?
  contingencyBasisPoints   Int?
  termsSummary             String                            @default("")
  signedDocumentVersion    DocumentVersion?                  @relation("RetainerAgreement_signedDocumentVersion", fields: [signedDocumentVersionId], references: [id])
  signedDocumentVersionId  String?                           @map("signedDocumentVersion")
