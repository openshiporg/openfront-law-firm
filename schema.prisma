  updatedAt       DateTime            @default(now()) @updatedAt

  @@index([firmId])
  @@index([matterId])
  @@index([userId])
  @@index([taskId])
  @@index([approvedById])
}

model Expense {
  id               String                  @id @default(cuid())
  firm             Firm                    @relation("Expense_firm", fields: [firmId], references: [id])
  firmId           String                  @map("firm")
  matter           Matter                  @relation("Expense_matter", fields: [matterId], references: [id])
